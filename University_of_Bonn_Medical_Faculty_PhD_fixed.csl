<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-GB" demote-non-dropping-particle="sort-only">
  <info>
    <title>University of Bonn - Faculty of Medicine PhD (custom draft)</title>
    <id>https://example.org/styles/university-of-bonn-medical-faculty-phd-custom-draft</id>
    <link href="https://example.org/styles/university-of-bonn-medical-faculty-phd-custom-draft" rel="self"/>
    <link href="https://www.medfak.uni-bonn.de/de/fakultaet/karrierewege/nachwuchsfoerderung/promotion-phd/formale-kriterien-hinweise-eng_august-2025.pdf" rel="documentation"/>
    <author><name>Custom thesis style</name></author>
    <category citation-format="author-date"/>
    <category field="medicine"/>
    <summary>Draft CSL based on University of Bonn Faculty of Medicine PhD thesis guidelines (August 2025). Check output before submission.</summary>
    <updated>2026-10-25T00:00:00+00:00</updated>
  </info>
  <macro name="author-short">
    <names variable="author"><name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/></names>
  </macro>
  <macro name="author-full">
    <names variable="author"><name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/><substitute><names variable="editor"/></substitute></names>
  </macro>
  <macro name="editor-full">
    <names variable="editor"><name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/><label form="short" prefix=", "/></names>
  </macro>
  <macro name="issued-year"><date variable="issued"><date-part name="year"/></date><text variable="year-suffix"/></macro>
  <macro name="pages"><text variable="page"/></macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year-suffix">
    <sort><key macro="author-short"/><key variable="issued"/></sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", "><text macro="author-short"/><text macro="issued-year"/></group>
    </layout>
  </citation>
  <bibliography hanging-indent="false" entry-spacing="0" line-spacing="1">
    <sort><key macro="author-full"/><key variable="issued"/><key variable="title"/></sort>
    <layout>
      <group delimiter=". ">
        <text macro="author-full"/>
        <text variable="title"/>
      </group>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group prefix=". " delimiter=" ">
            <text variable="container-title" form="short" strip-periods="true"/>
            <group delimiter="; ">
              <text macro="issued-year"/>
              <group delimiter=": ">
                <text variable="volume"/>
                <text macro="pages"/>
              </group>
            </group>
          </group>
        </if>
        <else-if type="chapter paper-conference" match="any">
          <group prefix=". In: " delimiter=". ">
            <text macro="editor-full"/>
            <text variable="container-title"/>
          </group>
          <group prefix=". " delimiter=", ">
            <group delimiter=": "><text variable="publisher-place"/><text variable="publisher"/></group>
            <group delimiter=": "><text macro="issued-year"/><text macro="pages"/></group>
          </group>
        </else-if>
        <else-if type="book">
          <group prefix=". " delimiter=", ">
            <group delimiter=": "><text variable="publisher-place"/><text variable="publisher"/></group>
            <text macro="issued-year"/>
          </group>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <group prefix=". " delimiter=": "><text macro="issued-year"/><text variable="URL"/></group>
          <date variable="accessed" prefix=" (date accessed: " suffix=")"><date-part name="day" form="numeric-leading-zeros" suffix="."/><date-part name="month" form="numeric-leading-zeros" suffix="."/><date-part name="year"/></date>
        </else-if>
        <else>
          <group prefix=". " delimiter=", "><text variable="container-title"/><text macro="issued-year"/><text variable="publisher"/></group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
